<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Production-safe default.
      Debug builds override this via src/debug/res/xml/network_security_config.xml
      so we don't commit private LAN IPs here.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">listmanager-api.onrender.com</domain>
    </domain-config>
</network-security-config>