# Example environment configuration for the List Manager backend.
# Copy to `.env` and fill in real values. Do NOT commit a real .env.

# REQUIRED. JWT signing secret. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app FAILS TO START if this is unset (no insecure fallback).
SECRET_KEY=change-me-to-a-long-random-secret

# JWT signing algorithm (default: HS256).
ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database connection URL (default: sqlite:///./listmanager.db).
# Postgres example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./listmanager.db

# Enable/disable auth endpoint rate limiting (default: true).
# Set to false in test environments to avoid throttling.
RATE_LIMIT_ENABLED=true

# ===== Startup seeding (see app/seed_admin.py) =====
# Admin account password, seeded idempotently on startup. If unset, NO admin
# user is created (there is no insecure default). Set this in production.
ADMIN_PASSWORD=change-me-strong
# Optional dev-only test user. Requires SEED_DEV_USERS=true AND a password.
SEED_DEV_USERS=false
TEST_USER_PASSWORD=

# ===== Speech transcription (server-side, audio -> text only) =====
# Groq API key for the OpenAI-compatible transcription endpoint.
# Optional: the app starts without it; transcription requests fail (502) until set.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Transcription model (default: whisper-large-v3-turbo).
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Maximum accepted audio upload size in bytes (default: 26214400 = 25 MB).
MAX_AUDIO_BYTES=26214400
