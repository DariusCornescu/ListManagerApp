# Example environment configuration for the List Manager backend.
# Copy to `.env` and fill in real values. Do NOT commit a real .env.

# REQUIRED. JWT signing secret. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app FAILS TO START if this is unset (no insecure fallback).
SECRET_KEY=change-me-to-a-long-random-secret

# JWT signing algorithm (default: HS256).
ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database connection URL (default: sqlite:///./listmanager.db).
# Postgres example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./listmanager.db

# Enable/disable auth endpoint rate limiting (default: true).
# Set to false in test environments to avoid throttling.
RATE_LIMIT_ENABLED=true
